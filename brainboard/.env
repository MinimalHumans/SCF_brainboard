VITE_GOOGLE_CLIENT_ID=680081158889-qq1cp5mv9gvp6n4tvhk1l007f01u7v3k.apps.googleusercontent.com
# brainboard/public/auth/index.php ships with every build (Vite copies
# public/ into dist/ verbatim, same as favicon.ico), landing at
# <site-root>/auth/index.php once deployed. Safe to leave set even before
# the one-time server-side config file exists — googleAuth.ts falls back to
# the plain implicit-token flow whenever the broker is unreachable or
# unconfigured.
VITE_AUTH_BROKER_URL=https://scriptyard.minimalhumans.com/auth/index.php
